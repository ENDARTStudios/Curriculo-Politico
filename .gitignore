# Dependências
node_modules/

# Next.js
.next/
out/
*.tsbuildinfo

# Ambiente (nunca versionar segredos) — exceção: apps/web/.env.example
.env*
!apps/web/.env.example

# Dados brutos coletados pelo ETL (cache local, não versionado)
data/

# Python
__pycache__/
*.pyc
.venv/

# Sistema / Deploy
.DS_Store
.vercel

# Estado local do Supabase CLI: guarda apenas a ref do projeto linkado e a versão
# do binário. É cache por máquina, não configuração do projeto — cada dev linka o
# seu. O arquivo de configuração do Supabase, se um dia existir, é `config.toml`,
# que fica fora daqui e pode ser versionado.
supabase/.temp/
supabase/.branches/

# Artefatos locais de revisão de UI (capturas do @.design-review/capture.cjs e
# da auditoria de rotas). O script é versionado; as imagens geradas, não — são
# pesadas (28 capturas ≈ 6,5 MB) e reproduzíveis pelo próprio script.
#
# `**` é obrigatório: `.design-review/*.png` cobre só o primeiro nível, e a
# auditoria grava em `.design-review/auditoria/`. Foi assim que 28 PNGs entraram
# num commit.
.design-review/**/*.png
.design-review/*.png

# Relatório da auditoria de rotas: saída de execução, não fonte.
auditoria-visual.json

# Renders do documento de identidade (design/construir-identidade.mjs).
# Mesma regra: o gerador e o `.figcraft` são versionados; os PNGs saem do build.
design/export/

# Impeccable: estado efêmero, cache de hook e overrides por máquina.
# Os artefatos compartilhados (config.json, design.json, surfaces/, critique/)
# seguem versionados de propósito — são o contrato de design do projeto.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/server.json
**/.impeccable/live/sessions/
**/.impeccable/live/previews/
**/.impeccable/live/annotations/
**/.impeccable/live/cache/
**/.impeccable/live/manual-edit-apply-transaction.json
**/.impeccable/live/manual-edit-events.jsonl
**/.impeccable/live/manual-edit-evidence/
**/.impeccable/live/pending-manual-edits.json
**/.impeccable/live/deferred-svelte-component-accepts.json
**/.impeccable/live/*.png

# O engine do Impeccable é um binário de ~20 MB por plataforma. Ele é
# rebaixado automaticamente pelo launcher na primeira execução, então não
# precisa viajar no repositório (e não deve: é específico de SO/arquitetura).
.dsh/skills/impeccable/scripts/bin/

# Artefatos do Playwright: relatórios, traces e capturas de falha são
# reproduzíveis pelo próprio `npm run e2e` e não pertencem ao repositório.
test-results/
playwright-report/
blob-report/
.playwright/

# Indexer (Graft)
/graft/
