generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReliabilityStatus {
  GREEN
  YELLOW
  RED
  GRAY
}

enum LegalStatus {
  INVESTIGATION
  LAWSUIT
  CONDEMNATION
  IMPEACHMENT
  CLEARED
  ACCOUNTS_REJECTED
  CRIMINAL_ACTION
}

enum ActionType {
  PROPOSED
  APPROVED
  VOTED
  AUTHORED
}

model Person {
  id            String        @id @default(cuid())
  externalId    String?       @unique // ID da Câmara/Senado/TSE
  tseId         String?       @unique // SQ_CANDIDATO da eleição que elegeu o político
  civilName     String
  politicalName String
  birthYear     Int?
  photoUrl      String?
  terms         Term[]
  legalRecords  LegalRecord[]
  billAuthorships BillAuthorship[]
  verifiedClaims VerifiedClaim[]
  createdAt     DateTime      @default(now())
}

model Party {
  id          String   @id @default(cuid())
  acronym     String   @unique
  name        String
  ideology    String? // "Social-democracia", "Liberalismo econômico"
  position    String? // "ESQUERDA" | "CENTRO_ESQUERDA" | "CENTRO" | "CENTRO_DIREITA" | "DIREITA"
  foundedYear Int?
  history     String?  @db.Text
  tseNumber   Int?
  color       String? // hex para gráficos
  members     Term[]
}

model Office {
  id           String @id @default(cuid())
  type         String // "EXECUTIVE" | "LEGISLATIVE"
  name         String // "Deputado Federal", "Governador"
  jurisdiction String // "BR", "SP", "RJ"
  terms        Term[]
}

model Term {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id])
  officeId String
  office   Office @relation(fields: [officeId], references: [id])
  partyId  String?
  party    Party?  @relation(fields: [partyId], references: [id])
  startYear Int
  endYear  Int?
  isFirstTerm Boolean @default(false)
  previousTerms Int   @default(0)
  scores   Score[]
  actions  LegislativeAction[]
  finances CampaignFinance[]
  sessionAttendances SessionAttendance[]
  scoreSnapshots ScoreSnapshot[]

  @@index([personId])
  @@index([officeId])
}

/// Histórico mensal da nota (Rastreamento Temporal — /metodologia)
model ScoreSnapshot {
  id                String            @id @default(cuid())
  termId            String
  term              Term              @relation(fields: [termId], references: [id], onDelete: Cascade)
  snapshotDate      DateTime
  finalScore        Float
  confidenceScore   Float
  reliabilityStatus ReliabilityStatus
  breakdown         Json?
  events            Json?

  @@unique([termId, snapshotDate])
  @@index([snapshotDate])
}

model Bill {
  id            String   @id @default(cuid())
  externalId    String?  @unique
  title         String
  type          String?
  status        String?
  date          DateTime?
  tags          Json? // ["saude", "economia", ...] p/ Filtro de Afinidade
  authorships   BillAuthorship[]
  userVotes     UserBillVote[]
  createdAt     DateTime @default(now())

  @@index([externalId])
  @@index([type])
  @@index([date])
}

/// Camada de ENGAJAMENTO PESSOAL — nunca altera o IDIP (Neutralidade Algorítmica, /metodologia).
/// User enxuto: Account/Session entram com o NextAuth na Fase 4.
model User {
  id            String         @id @default(cuid())
  email         String?        @unique
  name          String?
  password      String? // hash bcrypt (credentials)
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  billVotes     UserBillVote[]
  affinities    UserAffinity[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String @id @default(cuid())
  userId            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserBillVote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  vote      String // "FAVOR" | "CONTRA"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, billId])
  @@index([billId])
}

model UserAffinity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     String // "privatizacao", "direitos_humanos", "meio_ambiente", etc
  stance    String // "FAVOR" | "CONTRA" | "NEUTRO"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, topic])
}

model BillAuthorship {
  id            String   @id @default(cuid())
  billId        String
  bill          Bill     @relation(fields: [billId], references: [id])
  personId      String
  person        Person   @relation(fields: [personId], references: [id])
  type          String? // "Autor", "Coautor", "Relator"
  createdAt     DateTime @default(now())

  @@unique([billId, personId])
  @@index([personId])
}

model SessionAttendance {
  id            String   @id @default(cuid())
  termId        String
  term          Term     @relation(fields: [termId], references: [id])
  sessionDate   DateTime
  sessionType   String?
  present       Boolean
  externalId    String? // id do evento na Câmara, para idempotência

  @@unique([termId, sessionDate, externalId])
  @@index([termId])
}

model CampaignFinance {
  id            String   @id @default(cuid())
  termId        String
  term          Term     @relation(fields: [termId], references: [id])
  year          Int
  totalReceived Float
  totalSpent    Float
  donorCount    Int
  topDonors     Json? // Array de {nome, valor}
  source        String // "TSE_2022"
  retrievedAt   DateTime @default(now())

  @@unique([termId, year])
  @@index([termId])
}

model LegislativeAction {
  id            String     @id @default(cuid())
  termId        String
  term          Term       @relation(fields: [termId], references: [id])
  actionType    ActionType
  billId        String? // id da VOTAÇÃO na Câmara
  proposicaoId  String? // id da PROPOSIÇÃO votada (ponte p/ tags de afinidade)
  voteDirection String?
  isSecretVote  Boolean @default(false)
  date          DateTime?
  createdAt     DateTime   @default(now())

  @@unique([termId, actionType, billId])
  @@index([termId])
  @@index([proposicaoId])
}

model LegalRecord {
  id          String      @id @default(cuid())
  personId    String
  person      Person      @relation(fields: [personId], references: [id])
  type        LegalStatus
  status      String // "ATIVO", "ARQUIVADO", "TRANSITADO_EM_JULGADO"
  court       String?
  sourceUrl   String
  retrievedAt DateTime    @default(now())

  @@index([personId])
}

model Score {
  id                String            @id @default(cuid())
  termId            String
  term              Term              @relation(fields: [termId], references: [id])
  version           String            @default("1.0.0")
  finalScore        Float
  confidenceScore   Float
  reliabilityStatus ReliabilityStatus
  integrityScore    Float
  productivityScore Float
  transparencyScore Float
  calculatedAt      DateTime          @default(now())

  @@index([termId])
  @@index([finalScore])
}

// ─── Judiciário: STF (estrutura pronta; ETL das decisões é fase específica —
// as decisões são publicadas no DJE sem API consolidada) ───

model StfJustice {
  id              String     @id @default(cuid())
  name            String     @unique
  birthYear       Int?
  appointedBy     String? // Presidente que indicou
  appointmentDate DateTime?
  active          Boolean    @default(true)
  scores          StfScore[]
  votes           StfVote[]
  createdAt       DateTime   @default(now())
}

model StfCase {
  id           String    @id @default(cuid())
  externalId   String?   @unique // Número do processo (ex: ADI 1234)
  title        String
  category     String? // "ADI", "ADPF", "RE", "HC"
  status       String?
  decisionDate DateTime?
  votes        StfVote[]
  createdAt    DateTime  @default(now())
}

model StfVote {
  id            String     @id @default(cuid())
  justiceId     String
  justice       StfJustice @relation(fields: [justiceId], references: [id])
  caseId        String
  case          StfCase    @relation(fields: [caseId], references: [id])
  voteDirection String // "PROCEDENTE", "IMPROCEDENTE", "PARCIAL"
  wasRapporteur Boolean    @default(false)
  dissent       Boolean    @default(false)
  voteDate      DateTime?

  @@unique([justiceId, caseId])
}

model StfScore {
  id                String     @id @default(cuid())
  justiceId         String
  justice           StfJustice @relation(fields: [justiceId], references: [id])
  periodStart       DateTime
  periodEnd         DateTime
  finalScore        Float
  confidenceScore   Float
  productivityScore Float
  consistencyScore  Float
  transparencyScore Float
  calculatedAt      DateTime   @default(now())

  @@unique([justiceId, periodStart])
}

// ─── Ranking Histórico (educacional — critérios adaptados por era, /historia) ───

model HistoricalEra {
  id          String   @id @default(cuid())
  name        String   @unique
  startYear   Int
  endYear     Int
  description String?
  politicians HistoricalPolitician[]
}

model HistoricalPolitician {
  id              String        @id @default(cuid())
  name            String
  eraId           String
  era             HistoricalEra @relation(fields: [eraId], references: [id])
  office          String // "Presidente", "Senador", "Deputado"
  startYear       Int
  endYear         Int?
  party           String?
  achievements    Json? // fatos documentados
  controversies   Json? // eventos notórios
  historicalScore Float?
  scoreBreakdown  Json?
  sources         Json? // links para fontes
  createdAt       DateTime      @default(now())

  @@unique([name, office, startYear])
}

// ─── Checagens de agências independentes (contexto — nunca altera o IDIP) ───

model VerifiedClaim {
  id          String    @id @default(cuid())
  personId    String?
  person      Person?   @relation(fields: [personId], references: [id])
  claimText   String    @db.Text
  verdict     String // "VERDADEIRO", "FALSO", "ENGANOSO", "IMPRECISO"
  source      String // "Aos Fatos", "Lupa", "Comprova"
  sourceUrl   String
  publishedAt DateTime?
  topic       String?
  fetchedAt   DateTime  @default(now())

  @@index([personId])
  @@index([verdict])
}
