generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReliabilityStatus {
  GREEN
  YELLOW
  RED
  GRAY
}

enum LegalStatus {
  INVESTIGATION
  LAWSUIT
  CONDEMNATION
  IMPEACHMENT
  CLEARED
}

enum ActionType {
  PROPOSED
  APPROVED
  VOTED
  AUTHORED
}

model Person {
  id            String        @id @default(cuid())
  externalId    String?       @unique // ID da Câmara/Senado/TSE
  tseId         String?       @unique // SQ_CANDIDATO da eleição que elegeu o político
  civilName     String
  politicalName String
  birthYear     Int?
  photoUrl      String?
  terms         Term[]
  legalRecords  LegalRecord[]
  billAuthorships BillAuthorship[]
  createdAt     DateTime      @default(now())
}

model Party {
  id       String   @id @default(cuid())
  acronym  String   @unique
  name     String
  ideology String?
  members  Term[]
}

model Office {
  id           String @id @default(cuid())
  type         String // "EXECUTIVE" | "LEGISLATIVE"
  name         String // "Deputado Federal", "Governador"
  jurisdiction String // "BR", "SP", "RJ"
  terms        Term[]
}

model Term {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id])
  officeId String
  office   Office @relation(fields: [officeId], references: [id])
  partyId  String?
  party    Party?  @relation(fields: [partyId], references: [id])
  startYear Int
  endYear  Int?
  scores   Score[]
  actions  LegislativeAction[]
  finances CampaignFinance[]
  sessionAttendances SessionAttendance[]

  @@index([personId])
  @@index([officeId])
}

model Bill {
  id            String   @id @default(cuid())
  externalId    String?  @unique
  title         String
  type          String?
  status        String?
  date          DateTime?
  authorships   BillAuthorship[]
  createdAt     DateTime @default(now())

  @@index([externalId])
}

model BillAuthorship {
  id            String   @id @default(cuid())
  billId        String
  bill          Bill     @relation(fields: [billId], references: [id])
  personId      String
  person        Person   @relation(fields: [personId], references: [id])
  type          String? // "Autor", "Coautor", "Relator"
  createdAt     DateTime @default(now())

  @@unique([billId, personId])
  @@index([personId])
}

model SessionAttendance {
  id            String   @id @default(cuid())
  termId        String
  term          Term     @relation(fields: [termId], references: [id])
  sessionDate   DateTime
  sessionType   String?
  present       Boolean
  externalId    String? // id do evento na Câmara, para idempotência

  @@unique([termId, sessionDate, externalId])
  @@index([termId])
}

model CampaignFinance {
  id            String   @id @default(cuid())
  termId        String
  term          Term     @relation(fields: [termId], references: [id])
  year          Int
  totalReceived Float
  totalSpent    Float
  donorCount    Int
  topDonors     Json? // Array de {nome, valor}
  source        String // "TSE_2022"
  retrievedAt   DateTime @default(now())

  @@unique([termId, year])
  @@index([termId])
}

model LegislativeAction {
  id            String     @id @default(cuid())
  termId        String
  term          Term       @relation(fields: [termId], references: [id])
  actionType    ActionType
  billId        String?
  voteDirection String?
  date          DateTime?
  createdAt     DateTime   @default(now())

  @@unique([termId, actionType, billId])
  @@index([termId])
}

model LegalRecord {
  id          String      @id @default(cuid())
  personId    String
  person      Person      @relation(fields: [personId], references: [id])
  type        LegalStatus
  status      String // "ATIVO", "ARQUIVADO", "TRANSITADO_EM_JULGADO"
  court       String?
  sourceUrl   String
  retrievedAt DateTime    @default(now())

  @@index([personId])
}

model Score {
  id                String            @id @default(cuid())
  termId            String
  term              Term              @relation(fields: [termId], references: [id])
  version           String            @default("1.0.0")
  finalScore        Float
  confidenceScore   Float
  reliabilityStatus ReliabilityStatus
  integrityScore    Float
  productivityScore Float
  transparencyScore Float
  calculatedAt      DateTime          @default(now())

  @@index([termId])
  @@index([finalScore])
}
