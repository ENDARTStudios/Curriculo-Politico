generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL: conexão de runtime. Em produção aponta para o pooler Supabase em
  // TRANSACTION mode (porta 6543, com ?pgbouncer=true&connection_limit=1) — serverless
  // não deve usar session mode, que limita a 15 clientes e derruba o site em deploy.
  url = env("DATABASE_URL")
  // DIRECT_URL: conexão direta (porta 5432) para `prisma migrate`/`db push`, que NÃO
  // funcionam em transaction mode. Também é a conexão usada pelos ETLs de carga.
  directUrl = env("DIRECT_URL")
}

enum ReliabilityStatus {
  GREEN
  YELLOW
  RED
  GRAY
}

enum LegalStatus {
  INVESTIGATION
  LAWSUIT
  CONDEMNATION
  IMPEACHMENT
  CLEARED
  ACCOUNTS_REJECTED
  CRIMINAL_ACTION
}

enum ActionType {
  PROPOSED
  APPROVED
  VOTED
  AUTHORED
}

model Person {
  id            String        @id @default(cuid())
  externalId    String?       @unique // ID da Câmara/Senado/TSE
  tseId         String?       @unique // SQ_CANDIDATO da eleição que elegeu o político
  civilName     String
  politicalName String
  birthYear     Int?
  photoUrl      String?
  terms         Term[]
  legalRecords  LegalRecord[]
  billAuthorships BillAuthorship[]
  follows       Follow[]
  verifiedClaims  VerifiedClaim[]
  patrimonyHistory PatrimonyHistory[]
  municipalExpenses MunicipalExpense[]
  createdAt     DateTime      @default(now())
}

model Party {
  id          String   @id @default(cuid())
  acronym     String   @unique
  name        String
  ideology    String? // "Social-democracia", "Liberalismo econômico"
  position    String? // "ESQUERDA" | "CENTRO_ESQUERDA" | "CENTRO" | "CENTRO_DIREITA" | "DIREITA"
  foundedYear Int?
  history     String?  @db.Text
  tseNumber   Int?
  color       String? // hex para gráficos
  /// URL da logo oficial da legenda.
  ///
  /// Nulo é o estado normal, não um defeito: a maioria das legendas não teve a
  /// logo carregada. A interface cai para um monograma com a sigla e a cor do
  /// partido — nunca para uma imagem quebrada nem para o logo de outro partido.
  ///
  /// As marcas pertencem às legendas; o uso aqui é nominativo (identificar a
  /// agremiação), não endosso.
  logoUrl     String?
  members     Term[]
  follows     Follow[]
}

model Office {
  id           String @id @default(cuid())
  type         String // "EXECUTIVE" | "LEGISLATIVE"
  name         String // "Deputado Federal", "Governador"
  jurisdiction String // "BR", "SP", "RJ"
  terms        Term[]
}

model Term {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id])
  officeId String
  office   Office @relation(fields: [officeId], references: [id])
  partyId  String?
  party    Party?  @relation(fields: [partyId], references: [id])
  startYear Int
  endYear  Int?
  isFirstTerm Boolean @default(false)
  previousTerms Int   @default(0)
  scores   Score[]
  actions  LegislativeAction[]
  finances CampaignFinance[]
  sessionAttendances SessionAttendance[]
  scoreSnapshots ScoreSnapshot[]
  costs    PoliticianCost[]

  @@index([personId])
  @@index([officeId])
}

/// Histórico mensal da nota (Rastreamento Temporal — /metodologia)
model ScoreSnapshot {
  id                String            @id @default(cuid())
  termId            String
  term              Term              @relation(fields: [termId], references: [id], onDelete: Cascade)
  snapshotDate      DateTime
  finalScore        Float
  confidenceScore   Float
  reliabilityStatus ReliabilityStatus
  breakdown         Json?
  events            Json?

  @@unique([termId, snapshotDate])
  @@index([snapshotDate])
}

model Bill {
  id            String   @id @default(cuid())
  externalId    String?  @unique
  title         String
  type          String?
  status        String?
  date          DateTime?
  tags          Json? // ["saude", "economia", ...] p/ Filtro de Afinidade
  fullText      String?  @db.Text
  simpleSummary String?  @db.Text // resumo por categoria temática
  citizenImpact String?  @db.Text // como afeta o cidadão
  keyPoints     Json?
  authorships   BillAuthorship[]
  userVotes     UserBillVote[]
  follows       Follow[]
  createdAt     DateTime @default(now())

  @@index([externalId])
  @@index([type])
  @@index([date])
}

/// Camada de ENGAJAMENTO PESSOAL — nunca altera o IDIP (Neutralidade Algorítmica, /metodologia).
/// Consentimentos versionados (LGPD Art. 8º): aceite de Termos/Privacidade
/// (clickwrap) e consentimento ESPECÍFICO p/ opinião política (dado sensível,
/// Art. 11) gravados com versão e timestamp; revogação zera o direito de voto
/// e elimina os votos existentes.
model User {
  id                          String         @id @default(cuid())
  email                       String?        @unique
  name                        String?
  password                    String? // hash bcrypt (credentials)
  emailVerified               DateTime?
  image                       String?
  termsVersion                String? // versão dos Termos aceitos no cadastro
  termsAcceptedAt             DateTime?
  politicalConsentVersion     String? // versão do consentimento específico (dado sensível)
  politicalConsentAt          DateTime?
  politicalConsentWithdrawnAt DateTime? // revogação — elimina UserBillVote
  accounts                    Account[]
  sessions                    Session[]
  billVotes                   UserBillVote[]
  follows                     Follow[]
  spectrumResults             SpectrumResult[]
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
}

/// O que a pessoa acompanha: político, partido ou projeto.
///
/// ── Por que três FKs anuláveis, e não `targetType` + `targetId` ────────────
/// Um discriminador textual exigiria que a integridade fosse mantida pela
/// aplicação: ao remover um político do acervo, o acompanhamento ficaria órfão e
/// a dashboard mostraria "desconhecido". Com FK real, `onDelete: Cascade`
/// resolve, e o banco recusa um id que não existe.
///
/// O custo é uma restrição `CHECK` para garantir que exatamente uma das três
/// colunas esteja preenchida — adicionada na migração, porque o Prisma não
/// expressa isso no schema.
model Follow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personId  String?
  person    Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  partyId   String?
  party     Party?   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  billId    String?
  bill      Bill?    @relation(fields: [billId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // No Postgres, NULLs são distintos: cada restrição só vale quando a coluna
  // está preenchida, então um usuário pode seguir 1 político, 1 partido e 1
  // projeto sem que as três colisões se atrapalhem.
  @@unique([userId, personId])
  @@unique([userId, partyId])
  @@unique([userId, billId])
  @@index([userId, createdAt])
  @@index([personId])
  @@index([partyId])
  @@index([billId])
}

/// Resultado do teste de espectro político, salvo pelo próprio usuário.
model SpectrumResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Pontuação por eixo, de -100 a 100. Guardado como JSON porque o conjunto de
  /// eixos muda com o questionário — colunas fixas obrigariam uma migração a
  /// cada eixo novo, e resultados antigos ficariam incomparáveis em silêncio.
  scores    Json
  /// Versão do questionário. Sem isto, comparar um resultado de hoje com um de
  /// meses atrás seria enganoso e a pessoa não saberia por quê.
  versao    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserBillVote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  vote      String // "FAVOR" | "CONTRA"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, billId])
  @@index([billId])
}

/// Canal de retificação/direitos do titular (LGPD Art. 18) — público,
/// sem login (o titular pode não ter conta). Protocolo rastreável.
model RetificationRequest {
  id             String   @id @default(cuid())
  protocolo      String   @unique
  requesterName  String
  requesterEmail String
  targetType     String // "POLITICO" | "USUARIO" | "OUTRO"
  targetName     String?
  description    String
  sourceUrl      String?
  status         String   @default("RECEBIDO") // RECEBIDO | EM_ANALISE | CONCLUIDO | DEFERIDO | INDEFERIDO
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([requesterEmail])
}

model BillAuthorship {
  id            String   @id @default(cuid())
  billId        String
  bill          Bill     @relation(fields: [billId], references: [id])
  personId      String
  person        Person   @relation(fields: [personId], references: [id])
  type          String? // "Autor", "Coautor", "Relator"
  createdAt     DateTime @default(now())

  @@unique([billId, personId])
  @@index([personId])
}

model SessionAttendance {
  id            String   @id @default(cuid())
  termId        String
  term          Term     @relation(fields: [termId], references: [id])
  sessionDate   DateTime
  sessionType   String?
  present       Boolean
  externalId    String? // id do evento na Câmara, para idempotência

  @@unique([termId, sessionDate, externalId])
  @@index([termId])
}

model CampaignFinance {
  id            String   @id @default(cuid())
  termId        String
  term          Term     @relation(fields: [termId], references: [id])
  year          Int
  totalReceived Float
  totalSpent    Float
  donorCount    Int
  topDonors     Json? // Array de {nome, valor}
  source        String // "TSE_2022"
  retrievedAt   DateTime @default(now())

  @@unique([termId, year])
  @@index([termId])
}

model LegislativeAction {
  id            String     @id @default(cuid())
  termId        String
  term          Term       @relation(fields: [termId], references: [id])
  actionType    ActionType
  billId        String? // id da VOTAÇÃO na Câmara
  proposicaoId  String? // id da PROPOSIÇÃO votada (ponte p/ tags de afinidade)
  voteDirection String?
  isSecretVote  Boolean @default(false)
  date          DateTime?
  createdAt     DateTime   @default(now())

  @@unique([termId, actionType, billId])
  @@index([termId])
  @@index([proposicaoId])
}

model LegalRecord {
  id          String      @id @default(cuid())
  personId    String
  person      Person      @relation(fields: [personId], references: [id])
  type        LegalStatus
  status      String // "ATIVO", "ARQUIVADO", "TRANSITADO_EM_JULGADO"
  court       String?
  sourceUrl   String
  retrievedAt DateTime    @default(now())

  @@index([personId])
}

model Score {
  id                String            @id @default(cuid())
  termId            String
  term              Term              @relation(fields: [termId], references: [id])
  version           String            @default("1.0.0")
  finalScore        Float
  confidenceScore   Float
  reliabilityStatus ReliabilityStatus
  integrityScore      Float
  productivityScore   Float
  transparencyScore   Float
  costEfficiencyScore Float?
  calculatedAt        DateTime          @default(now())

  @@index([termId])
  @@index([finalScore])
}

// ─── Judiciário: STF (estrutura pronta; ETL das decisões é fase específica —
// as decisões são publicadas no DJE sem API consolidada) ───

model StfJustice {
  id              String     @id @default(cuid())
  name            String     @unique
  birthYear       Int?
  appointedBy     String? // Presidente que indicou
  appointmentDate DateTime?
  active          Boolean    @default(true)
  scores          StfScore[]
  votes           StfVote[]
  createdAt       DateTime   @default(now())
}

model StfCase {
  id           String    @id @default(cuid())
  externalId   String?   @unique // Número do processo (ex: ADI 1234)
  title        String
  category     String? // "ADI", "ADPF", "RE", "HC"
  status       String?
  decisionDate DateTime?
  votes        StfVote[]
  createdAt    DateTime  @default(now())
}

model StfVote {
  id            String     @id @default(cuid())
  justiceId     String
  justice       StfJustice @relation(fields: [justiceId], references: [id])
  caseId        String
  case          StfCase    @relation(fields: [caseId], references: [id])
  voteDirection String // "PROCEDENTE", "IMPROCEDENTE", "PARCIAL"
  wasRapporteur Boolean    @default(false)
  dissent       Boolean    @default(false)
  voteDate      DateTime?

  @@unique([justiceId, caseId])
}

model StfScore {
  id                String     @id @default(cuid())
  justiceId         String
  justice           StfJustice @relation(fields: [justiceId], references: [id])
  periodStart       DateTime
  periodEnd         DateTime
  finalScore        Float
  confidenceScore   Float
  productivityScore Float
  consistencyScore  Float
  transparencyScore Float
  /// IDIP-STF: mesma âncora de 25% do Legislativo/Executivo. Sem este campo o
  /// peso de Integridade do índice não teria onde ser gravado.
  integrityScore    Float      @default(50)
  calculatedAt      DateTime   @default(now())

  @@unique([justiceId, periodStart])
}

// ─── Ranking Histórico (educacional — critérios adaptados por era, /historia) ───

model HistoricalEra {
  id          String   @id @default(cuid())
  name        String   @unique
  startYear   Int
  endYear     Int
  description String?
  politicians HistoricalPolitician[]
}

model HistoricalPolitician {
  id              String        @id @default(cuid())
  name            String
  eraId           String
  era             HistoricalEra @relation(fields: [eraId], references: [id])
  office          String // "Presidente", "Senador", "Deputado"
  startYear       Int
  endYear         Int?
  party           String?
  achievements    Json? // fatos documentados
  controversies   Json? // eventos notórios
  historicalScore Float?
  scoreBreakdown  Json?
  sources         Json? // links para fontes
  createdAt       DateTime      @default(now())

  @@unique([name, office, startYear])
}

// ─── Checagens de agências independentes (contexto — nunca altera o IDIP) ───

model VerifiedClaim {
  id          String    @id @default(cuid())
  personId    String?
  person      Person?   @relation(fields: [personId], references: [id])
  claimText   String    @db.Text
  verdict     String // "VERDADEIRO", "FALSO", "ENGANOSO", "IMPRECISO"
  source      String // "Aos Fatos", "Lupa", "Comprova"
  sourceUrl   String
  publishedAt DateTime?
  topic       String?
  fetchedAt   DateTime  @default(now())

  @@index([personId])
  @@index([verdict])
}

// ─── Custo Total do Político (Requisito #26) ───

enum CostCategory {
  SALARY
  PATRIMONY
  CEAP
  CEAPS
  OFFICE_BUDGET
  HOUSING
  RELOCATION
  HEALTH_PLAN
  TRANSPORT
  OTHER_BENEFITS
}

model PoliticianCost {
  id          String       @id @default(cuid())
  termId      String
  term        Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  category    CostCategory
  year        Int
  amount      Float // R$
  description String?
  source      String // "TSE", "CAMARA", "SENADO", "FIXED"
  sourceUrl   String?
  retrievedAt DateTime     @default(now())

  @@unique([termId, category, year, description])
  @@index([termId, year])
  @@index([category])
}

/// Tabela de referência de valores fixos por cargo (subsídios/benefícios públicos)
model FixedBenefit {
  id            String       @id @default(cuid())
  officeType    String // "PRESIDENTE", "SENADOR", "DEPUTADO_FEDERAL"...
  category      CostCategory
  monthlyValue  Float
  description   String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime     @default(now())

  @@unique([officeType, category, effectiveFrom])
}

/// Menções em diários oficiais municipais (Querido Diário/OKBR) —
/// preparação para a escala municipal (fora do escopo IDIP v1)
model MunicipalExpense {
  id             String   @id @default(cuid())
  politicianName String // nome completo normalizado quando vinculado; "—" quando não
  personId       String?
  person         Person?  @relation(fields: [personId], references: [id])
  municipality   String
  state          String
  keyword        String?
  publishedAt    DateTime?
  gazetteUrl     String
  excerpt        String   @db.Text
  fetchedAt      DateTime @default(now())

  @@index([municipality])
  @@index([personId])
}

/// Patrimônio declarado por eleição (multi-eleição — Rastreamento Patrimonial)
model PatrimonyHistory {
  id            String   @id @default(cuid())
  personId      String
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  electionYear  Int
  declaredValue Float
  assetCount    Int
  source        String // "TSE_2022"
  sourceUrl     String?
  retrievedAt   DateTime @default(now())

  @@unique([personId, electionYear])
  @@index([personId])
}
