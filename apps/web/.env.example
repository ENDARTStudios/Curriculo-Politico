# Banco de dados (suba com: docker compose up -d db — host port 15432)
DATABASE_URL="postgresql://postgres:radar_civico@localhost:15432/curriculo?schema=public"

# ⚠️ Pool de conexões: o pooler Supabase em session mode (porta 5432) aceita
# apenas 15 clientes e esgota durante deploys (EMAXCONNSESSION → HTTP 500).
# Para ambientes serverless use o transaction pooler na porta 6543 com
# "?pgbouncer=true&connection_limit=1". Detalhes e evidências:
# docs/ops/AUDITORIA_PRODUCAO.md §0.7, item 5.

# ⚠️ ATENÇÃO: todo script de dados (db:load-*, recalculate-scores, db:snapshot,
# db:seed) grava no banco apontado por DATABASE_URL. Se você preencher esta
# variável com o Supabase de PRODUÇÃO, os comandos locais alteram produção.
# Mantenha desenvolvimento apontando para localhost:15432.
# `npm run db:seed` recusa rodar contra banco remoto (CP_ALLOW_REMOTE_SEED=1
# força, ciente de que insere parlamentares fictícios).

# Redis (cache de rankings — Fase 3, host port 16379)
# REDIS_URL="redis://localhost:16379"

# Sentry (monitoramento de erros — opcional, no-op sem DSN)
# SENTRY_DSN="https://...@sentry.io/..."
# NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."

# UptimeRobot (monitor de uptime — opcional)
# UPTIMEROBOT_API_KEY="..."

# Supabase (banco de produção)
# SUPABASE_PROJECT_ID=""
# SUPABASE_SECRET_KEY=""
# SUPABASE_PUBLISHABLE_KEY=""

# Google OAuth (login social — obter em console.cloud.google.com)
# GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."
# NEXT_PUBLIC_GOOGLE_ENABLED="1"  # exibe botão no signin quando credenciais existem
