{
  "name": "radar-civico",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma open-source de transparência política brasileira com o Índice de Desempenho e Integridade Pública (IDIP).",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "verify:scoring": "tsx scripts/verify-scoring.ts",
    "etl:camara": "python etl/camara_deputados.py",
    "etl:votacoes": "python etl/camara_votacoes.py",
    "etl:senado": "python etl/senado_federal.py",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:load-camara": "tsx scripts/load-camara.ts",
    "db:load-senado": "tsx scripts/load-senado.ts",
    "db:load-votacoes": "tsx scripts/load-votacoes.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
