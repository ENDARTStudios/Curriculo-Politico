{
  "name": "curriculo-politico",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma open-source de transparência política brasileira com o Índice de Desempenho e Integridade Pública (IDIP).",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "verify:scoring": "tsx scripts/verify-scoring.ts",
    "verify:identity": "tsx scripts/verify-identity.ts",
    "etl:camara": "python etl/camara_deputados.py",
    "etl:camara-completa": "python etl/camara_completa.py",
    "etl:votacoes": "python etl/camara_votacoes.py",
    "etl:votacoes-expandido": "python etl/camara_votacoes_expandido.py",
    "etl:senado": "python etl/senado_federal.py",
    "etl:tse": "python etl/tse_candidatos.py",
    "etl:receitas": "python etl/tse_receitas.py",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:load-camara": "tsx scripts/load-camara.ts",
    "db:load-camara-completa": "tsx scripts/load-camara-completa.ts",
    "db:load-senado": "tsx scripts/load-senado.ts",
    "db:load-votacoes": "tsx scripts/load-votacoes.ts",
    "db:load-votacoes-expandido": "tsx scripts/load-votacoes-expandido.ts",
    "db:load-finance": "tsx scripts/load-campaign-finance.ts",
    "resolve-identity": "tsx scripts/resolve-identity.ts",
    "typecheck": "tsc --noEmit",
    "db:load-votacoes-historico": "tsx scripts/load-votacoes-historico.ts",
    "db:load-proposicoes": "tsx scripts/load-proposicoes.ts",
    "db:load-presenca": "tsx scripts/load-presenca.ts",
    "recalculate-scores": "tsx scripts/recalculate-scores.ts",
    "etl:votacoes-historico": "python etl/camara_votacoes_historico.py",
    "etl:proposicoes": "python etl/camara_proposicoes.py",
    "etl:presenca": "python etl/camara_presenca.py"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
